# HMAC key for link, code and session hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it logs everyone out and invalidates pending links.
MAGIC_LINK_SECRET=

# Public origin of the app. https required except for localhost.
APP_BASE_URL=http://localhost:3000

# From header. The domain must have SPF / DKIM / DMARC configured in Resend.
EMAIL_FROM=开局 <login@example.com>

# Pick ONE way to send mail. With neither set, emails are printed to the console (dev only).
#
# (a) Resend API key. Takes precedence when set.
RESEND_API_KEY=
#
# (b) Any SMTP server: self-hosted (Postfix / Mailcow / Stalwart) or a provider's SMTP endpoint.
SMTP_HOST=
SMTP_PORT=587            # 465 = implicit TLS, 587 = STARTTLS, 25 = LAN relay
SMTP_USER=               # leave both empty if the relay trusts your IP instead of a login
SMTP_PASS=
# SMTP_SECURE=true       # force implicit TLS on a non-465 port
# SMTP_REJECT_UNAUTHORIZED=false   # only for a self-signed cert on a server you control

# Optional
APP_NAME=开局
SESSION_COOKIE_NAME=kaiju_session
PORT=3000
